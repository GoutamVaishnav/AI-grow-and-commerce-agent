# Optional Grok configuration. Leave blank to use the built-in intent fallback.
XAI_API_KEY=
XAI_MODEL=grok-2-latest

# Razorpay Test Mode. These values are server-only; never expose the secret
# in client code or commit real credentials to the repository.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MongoDB authentication. Create a free MongoDB Atlas database or point this
# to your local MongoDB server. AUTH_SECRET must be a random string with 32+
# characters and must stay private.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/shopagent_ai?retryWrites=true&w=majority
MONGODB_DB=shopagent_ai
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# This configured account receives the merchant role at signup. Every other
# account receives the standard user role.
MERCHANT_EMAIL=goutamvaishnav468@gmail.com
